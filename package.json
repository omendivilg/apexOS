{
    "name":  "apex-os",
    "version":  "1.0.0",
    "private":  true,
    "scripts":  {
                    "dev":  "concurrently \"npm run dev:server\" \"npm run dev:client\"",
                    "dev:server":  "nodemon server.js",
                    "dev:client":  "npm --prefix frontend run dev",
                    "build":  "npm --prefix frontend run build",
                    "start":  "node server.js",
                    "install:all":  "npm install \u0026\u0026 npm --prefix frontend install"
                },
    "dependencies":  {
                         "cors":  "^2.8.5",
                         "express":  "^4.21.2",
                         "sqlite3":  "^6.0.1",
                         "dotenv":  "^16.5.0"
                     },
    "devDependencies":  {
                            "concurrently":  "^9.1.2",
                            "nodemon":  "^3.1.10"
                        }
}
